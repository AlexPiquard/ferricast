using Gtk 4.0;
using Adw 1;

menu primary_menu {
  section {
    item {
      action: "app.preferences";
      label: _("_Preferences");
    }
    item {
      action: "win.show-help-overlay";
      label: _("_Keyboard Shortcuts");
    }
    item {
      action: "app.about";
      label: _("_About Ferricast");
    }
  }
}

template $MainWindow : Adw.ApplicationWindow {
  default-height: 200;
  default-width: 500;
  title: "Ferricast";

  Adw.ToolbarView {
    content: Gtk.Box {
      halign: center;
      margin-bottom: 32;
      margin-end: 32;
      margin-start: 32;
      margin-top: 32;
      spacing: 18;

      Gtk.Button {
        valign: center;
        clicked => $handle_record_clicked() swapped;
        accessibility {
          label: _("Start recording");
        }

        Adw.ButtonContent {
          icon-name: "folder-videos-symbolic";
          label: _("Start recording");
          valign: center;
        }
      }

      Gtk.Button {
        valign: center;
        clicked => $handle_open_clicked() swapped;
        accessibility {
          label: _("Open existing recording");
        }

        Adw.ButtonContent {
          icon-name: "folder-drag-accept-symbolic";
          label: _("Open existing recording");
          valign: center;
        }
      }
    };

    [top]
    Adw.HeaderBar headerbar {
      [end]
      Gtk.MenuButton {
        icon-name: "open-menu-symbolic";
        menu-model: primary_menu;
        primary: true;
        tooltip-text: _("Main Menu");
      }
    }
  }
}
